---
import type { CollectionEntry } from "astro:content";
import ProjectVisual from "./ProjectVisual.astro";
import { contentSlug } from "../utils/content";

interface Props {
  project: CollectionEntry<"projects">;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const categoryLabels = {
  mobile: "Mobile product",
  web: "Web platform",
  "ai-data": "AI + data",
  embedded: "Embedded + robotics",
};
const primaryLink = project.data.links[0];
const slug = contentSlug(project.id);
---

<article class="project-card" data-project-card data-category={project.data.category}>
  <a class="project-card-visual-link" href={`/work/${slug}`}>
    <ProjectVisual project={project} priority={priority} />
  </a>
  <div class="project-card-content">
    <div class="project-card-meta">
      <span>{categoryLabels[project.data.category]}</span>
      <span>{project.data.year}</span>
    </div>
    <h3><a href={`/work/${slug}`}>{project.data.title}</a></h3>
    <p>{project.data.summary}</p>
    <dl class="project-proof">
      <div>
        <dt>Role</dt>
        <dd>{project.data.role}</dd>
      </div>
      <div>
        <dt>Outcome</dt>
        <dd>{project.data.outcomes[0]}</dd>
      </div>
    </dl>
    <ul class="tag-list" aria-label="Technologies">
      {project.data.technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-card-links">
      <a class="text-link" href={`/work/${slug}`}>Read case study <span aria-hidden="true">↗</span></a>
      {
        primaryLink && (
          <a
            class="secondary-link"
            href={primaryLink.url}
            target="_blank"
            rel="noreferrer"
          >
            {primaryLink.label}
          </a>
        )
      }
    </div>
  </div>
</article>
