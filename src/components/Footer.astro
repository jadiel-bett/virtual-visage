---
import { Image } from "astro:assets";
import siteLogo from "@/assets/profile/portfolio-site-logo.png";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="Jadiel Bett, home">
        <Image
          class="brand-mark"
          src={siteLogo}
          alt=""
          width={64}
          height={64}
          format="webp"
          loading="eager"
        />
        <span class="brand-name">Jadiel Bett</span>
      </a>
      <p>Product engineering with a systems perspective.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/notes">Notes</a>
      <a href="/resume">Résumé</a>
    </nav>
    <div class="footer-meta">
      <a href="mailto:jadielbett@gmail.com">jadielbett@gmail.com</a>
      <p>© {year} Jadiel Bett</p>
    </div>
  </div>
</footer>
