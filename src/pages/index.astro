---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contentSlug } from "@/utils/content";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ContactSection from "@/components/ContactSection.astro";

const profile = await getEntry("profile", "main");
if (!profile) throw new Error("Missing profile content.");

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featuredRank)
  .sort((a, b) => (a.data.featuredRank ?? 99) - (b.data.featuredRank ?? 99));
const experiences = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const achievements = (await getCollection("achievements")).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.data.name,
    url: "https://jadielbett.com",
    email: `mailto:${profile.data.email}`,
    jobTitle: "Product Engineer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Nairobi",
      addressCountry: "KE",
    },
    sameAs: [profile.data.github, profile.data.linkedin],
    knowsAbout: [
      "Flutter",
      "Mobile application development",
      "Web development",
      "Machine learning",
      "Internet of Things",
      "Robotics",
      "Mechatronics",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Jadiel Bett",
    url: "https://jadielbett.com",
    description: profile.data.shortBio,
  },
];
---

<BaseLayout
  title="Jadiel Bett"
  description="Product engineer in Nairobi building reliable mobile, web, AI, IoT, and connected systems with a mechatronics perspective."
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Product engineer · Nairobi, Kenya</p>
        <h1>Software built with a systems perspective.</h1>
        <p class="hero-lead">
          I build dependable mobile and software products, combining Flutter,
          backend, web, and AI delivery with hands-on experience in robotics,
          electronics, and automation.
        </p>
        <div class="hero-actions">
          <a class="button" href="/work">View selected work <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/jadiel-bett-resume.pdf" download>
            Download résumé
          </a>
        </div>
        <span class="availability">{profile.data.availability}</span>
      </div>

      <aside class="hero-panel" aria-label="Engineering capability overview">
        <div class="hero-panel-content">
          <span class="hero-panel-label">One engineering practice</span>
          <ul class="system-list">
            <li>Mobile products <span>Flutter</span></li>
            <li>Web platforms <span>React + APIs</span></li>
            <li>Intelligent systems <span>Python + ML</span></li>
            <li>Connected hardware <span>IoT + robotics</span></li>
          </ul>
          <div class="hero-panel-footer">
            <strong>From interface decisions to physical-system constraints.</strong>
            <span class="orbit" aria-hidden="true"></span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="proof-strip" aria-label="Professional highlights">
    <div class="container proof-grid">
      <div class="proof-item">
        <strong>Mobile → embedded</strong>
        <span>Cross-domain product delivery</span>
      </div>
      <div class="proof-item">
        <strong>Google Play</strong>
        <span>Independent product published</span>
      </div>
      <div class="proof-item">
        <strong>BSc. Engineering</strong>
        <span>Mechatronics, JKUAT</span>
      </div>
      <div class="proof-item">
        <strong>Nairobi + remote</strong>
        <span>Roles and selected contracts</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="selected-work-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Products grounded in real constraints"
        intro="A focused selection across mobile applications, commerce, machine learning, and multidisciplinary engineering."
      />
      <div class="project-grid">
        {
          projects.slice(0, 4).map((project, index) => (
            <ProjectCard project={project} priority={index === 0} />
          ))
        }
      </div>
      <div class="section-link-row">
        <a class="button button-secondary" href="/work">
          Explore all projects <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="capabilities-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Capabilities"
        title="Useful depth, without the skill-cloud"
        intro="I work across the layers a product needs while keeping architecture, operations, and the user experience connected."
      />
      <div class="capability-grid">
        {
          profile.data.services.map((service, index) => (
            <article class="capability-card">
              <span>0{index + 1}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="container experience-grid">
      <div class="experience-intro">
        <SectionHeading
          eyebrow="Experience"
          title="Software practice shaped by engineering"
          intro="My path combines independent product work, formal engineering training, and practical exposure to physical systems."
        />
        <a class="text-link" href="/about">Full background <span aria-hidden="true">→</span></a>
      </div>
      <div class="timeline">
        {
          experiences.slice(0, 4).map((experience) => (
            <article class="timeline-item">
              <p class="timeline-period">
                {experience.data.startDate} — {experience.data.endDate}
              </p>
              <h3>
                {experience.data.position} <span>at {experience.data.organization}</span>
              </h3>
              <p>{experience.data.summary}</p>
              <ul class="tag-list" aria-label="Technologies and disciplines">
                {experience.data.technologies.slice(0, 5).map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="achievements-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Milestones"
        title="Evidence beyond a technology list"
      />
      <div class="achievement-grid">
        {
          achievements.map((achievement) => (
            <article class="achievement-card">
              <p class="eyebrow">{achievement.data.date} · {achievement.data.type}</p>
              <h3>{achievement.data.title}</h3>
              <p>{achievement.data.description}</p>
              {achievement.data.proofUrl && (
                <a
                  class="text-link"
                  href={achievement.data.proofUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  View evidence <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="notes-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Engineering notes"
        title="How I think about product systems"
        intro="Practical notes from the boundary between interface design, software architecture, data, and devices."
      />
      <div class="note-grid">
        {
          notes.slice(0, 2).map((note) => (
            <article class="note-card">
              <div class="note-card-meta">
                <span>{note.data.publishDate.toLocaleDateString("en-KE", { month: "short", year: "numeric" })}</span>
                <span>{note.data.readingMinutes} min read</span>
              </div>
              <h3><a href={`/notes/${contentSlug(note.id)}`}>{note.data.title}</a></h3>
              <p>{note.data.summary}</p>
              <a class="text-link" href={`/notes/${contentSlug(note.id)}`}>Read note <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection profile={profile} />
</BaseLayout>
