---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contentSlug } from "@/utils/content";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Engineering Notes"
  description="Practical writing from Jadiel Bett about Flutter, mobile engineering, real-time systems, machine learning, IoT, and multidisciplinary product design."
>
  <header class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Engineering notes</p>
        <h1>Decisions behind the finished interface.</h1>
        <p class="page-hero-lead">
          Practical writing about product architecture, mobile systems, data,
          machine learning, and the engineering trade-offs users rarely see.
        </p>
      </div>
      <aside class="page-hero-aside">
        <p>
          No trend summaries or generated news—just durable lessons grounded in
          projects and implementation work.
        </p>
      </aside>
    </div>
  </header>

  <section class="section">
    <div class="container note-grid">
      {
        notes.map((note) => (
          <article class="note-card">
            <div class="note-card-meta">
              <time datetime={note.data.publishDate.toISOString()}>
                {note.data.publishDate.toLocaleDateString("en-KE", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                })}
              </time>
              <span>{note.data.readingMinutes} min read</span>
            </div>
            <h2><a href={`/notes/${contentSlug(note.id)}`}>{note.data.title}</a></h2>
            <p>{note.data.summary}</p>
            <ul class="tag-list" aria-label="Article topics">
              {note.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <a class="text-link" href={`/notes/${contentSlug(note.id)}`}>Read note <span aria-hidden="true">→</span></a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
